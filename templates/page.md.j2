{# ============================================================
   页面主模板（Front matter + 正文占位）
   正文 body 已由 pipeline/generate.py 用五大组件随机重组后传入，
   本模板只负责结构化元数据，不含任何解读文案。
   ============================================================ #}
---
title: "{{ title | yaml }}"
description: "{{ description | yaml }}"
slug: "{{ slug }}"
date: {{ date }}
lastmod: {{ date }}
draft: false
type: "entry"
schema_type: "{{ schema_type }}"
region: "{{ region | yaml }}"
group: "{{ group }}"
keywords:
{% for kw in keywords %}
  - "{{ kw | yaml }}"
{% endfor %}
image:
  layout: "{{ layout }}"
  src: "{{ image }}"
  alt: "{{ alt | yaml }}"
{% if faqs %}
faq:
{% for f in faqs %}
  - question: "{{ f.q | yaml }}"
    answer: "{{ f.a | yaml }}"
{% endfor %}
{% endif %}
{% if related %}
related:
{% for r in related %}
  - title: "{{ r.title | yaml }}"
    url: "{{ r.url }}"
    anchor: "{{ r.anchor | yaml }}"
{% endfor %}
{% endif %}
outbound: "{{ outbound }}"
pipeline:
  source: "{{ source_name }}"
  words: {{ word_count }}
  similarity: {{ similarity }}
  lang: "{{ hugo_lang }}"
---

{{ body }}
