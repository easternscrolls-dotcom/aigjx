# ============================================================
# Cloudflare Pages 响应头（经 Git 集成随 public/ 部署）
# 目标：静态资源长缓存 + 不可变（内容哈希指纹保证安全更新），
#       HTML 不强制长缓存（保留平台默认，随每次部署更新）。
# 说明：Cloudflare _headers 对同一路径的多个匹配规则会合并，
#       此处仅对明确的静态资源设长缓存，不写全局 /* no-cache，
#       避免覆盖资源规则。
# ============================================================

# 指纹化 CSS（Hugo pipes fingerprint 产出 /css/main.<hash>.css）
/css/*
  Cache-Control: public, max-age=31536000, immutable

# 自托管横幅（SVG 站内图 + PNG 社交分享图），零热链、长期不变
/banners/*
  Cache-Control: public, max-age=31536000, immutable

# 站内静态资源（如有 js / 字体等）
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
